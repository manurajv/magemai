rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActivePlatformAdmin() {
      return isSignedIn()
        && request.auth.token.superAdmin == true
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.status == 'active';
    }

    function userCreateShape(uid) {
      return request.resource.data.keys().hasOnly([
          'id',
          'email',
          'emailVerified',
          'displayName',
          'phoneNumber',
          'photoPath',
          'locale',
          'status',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.status == 'active'
        && request.resource.data.photoPath == null
        && request.resource.data.phoneNumber == null
        && request.resource.data.locale == 'en'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLoginAt == null;
    }

    function userUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phoneNumber', 'locale', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && (
          request.resource.data.phoneNumber == null
          || request.resource.data.phoneNumber.matches('^\\+[1-9][0-9]{7,14}$')
        )
        && request.resource.data.locale == 'en';
    }

    // Step 5: the signed-in person can read and update their own profile.
    // Every other collection stays deny-all until step 9.
    match /users/{uid} {
      allow get: if isSelf(uid) || isActivePlatformAdmin();
      allow list: if isActivePlatformAdmin();
      allow create: if isSelf(uid) && userCreateShape(uid);
      allow update: if isSelf(uid) && userUpdateAllowed();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
