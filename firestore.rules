rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function platformAdminPath() {
      return /databases/$(database)/documents/platformAdmins/$(request.auth.uid);
    }

    function isActivePlatformAdmin() {
      return isSignedIn()
        && request.auth.token.superAdmin == true
        && exists(platformAdminPath())
        && get(platformAdminPath()).data.status == 'active';
    }

    function userUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phoneNumber', 'locale', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && (
          request.resource.data.phoneNumber == null
          || request.resource.data.phoneNumber.matches('^\\+[1-9][0-9]{7,14}$')
        )
        && request.resource.data.locale == 'en';
    }

    function membershipPath(businessId) {
      return /databases/$(database)/documents/businessMembers/$(businessId + '_' + request.auth.uid);
    }

    function membershipExists(businessId) {
      return isSignedIn() && exists(membershipPath(businessId));
    }

    function membership(businessId) {
      return get(membershipPath(businessId));
    }

    function isActiveMember(businessId) {
      return membershipExists(businessId)
        && membership(businessId).data.status == 'active'
        && membership(businessId).data.userId == request.auth.uid;
    }

    function roleIs(businessId, roles) {
      return isActiveMember(businessId)
        && membership(businessId).data.role in roles;
    }

    function isActiveManager(businessId) {
      return roleIs(businessId, ['owner', 'admin', 'manager']);
    }

    function isActiveOwnerOrAdmin(businessId) {
      return roleIs(businessId, ['owner', 'admin']);
    }

    // Profile creation is the syncAuthProfile callable. Clients may update
    // only the allow-list. Business records, slugs, and audit logs stay deny-all.
    match /users/{uid} {
      allow get: if isSelf(uid) || isActivePlatformAdmin();
      allow list: if isActivePlatformAdmin();
      allow create: if false;
      allow update: if isSelf(uid) && userUpdateAllowed();
      allow delete: if false;
    }

    match /platformSettings/{id} {
      allow get: if isSignedIn() && (id == 'global' || isActivePlatformAdmin());
      allow list: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /businesses/{businessId} {
      allow get: if isActiveMember(businessId) || isActivePlatformAdmin();
      allow list: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    // List allows three shapes: the caller's own userId, an active platform
    // admin, or a manager query that pins businessId. exists() runs before get().
    match /businessMembers/{memberId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isActivePlatformAdmin()
        || isActiveManager(resource.data.businessId)
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isActivePlatformAdmin()
        || (
          resource.data.businessId is string
          && isActiveManager(resource.data.businessId)
        )
      );
      allow create, update, delete: if false;
    }

    match /platformAdmins/{uid} {
      allow get: if isSignedIn() && (isSelf(uid) || isActivePlatformAdmin());
      allow list: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow get, list: if isActivePlatformAdmin()
        || (
          resource.data.scope == 'business'
          && resource.data.businessId is string
          && isActiveOwnerOrAdmin(resource.data.businessId)
        );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
