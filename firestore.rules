rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActivePlatformAdmin() {
      return isSignedIn()
        && request.auth.token.superAdmin == true
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.status == 'active';
    }

    function userUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phoneNumber', 'locale', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && (
          request.resource.data.phoneNumber == null
          || request.resource.data.phoneNumber.matches('^\\+[1-9][0-9]{7,14}$')
        )
        && request.resource.data.locale == 'en';
    }

    function memberPath(businessId) {
      return /databases/$(database)/documents/businessMembers/$(businessId + '_' + request.auth.uid);
    }

    function isActiveMember(businessId) {
      return isSignedIn()
        && exists(memberPath(businessId))
        && get(memberPath(businessId)).data.status == 'active'
        && get(memberPath(businessId)).data.userId == request.auth.uid;
    }

    function isActiveManager(businessId) {
      return isActiveMember(businessId)
        && get(memberPath(businessId)).data.role in ['owner', 'admin', 'manager'];
    }

    // Profile creation is the syncAuthProfile callable. Clients may update
    // only the allow-list. Business records, slugs, and audit logs stay deny-all.
    match /users/{uid} {
      allow get: if isSelf(uid) || isActivePlatformAdmin();
      allow list: if isActivePlatformAdmin();
      allow create: if false;
      allow update: if isSelf(uid) && userUpdateAllowed();
      allow delete: if false;
    }

    match /platformSettings/{id} {
      allow get: if isSignedIn() && (id == 'global' || isActivePlatformAdmin());
      allow list: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /businesses/{businessId} {
      allow get: if isActiveMember(businessId) || isActivePlatformAdmin();
      allow list: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    // A manager list filtered by businessId is intentionally omitted.
    // That query depends on resource data inside get(), which the rules
    // language rejects. Step 6 does not need a staff directory.
    match /businessMembers/{memberId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isActivePlatformAdmin()
        || isActiveManager(resource.data.businessId)
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isActivePlatformAdmin()
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
