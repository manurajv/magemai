{
  "name": "magemai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators:start": "node scripts/emulators.mjs start",
    "emulators:export": "node scripts/emulators.mjs export",
    "emulators:reset": "node scripts/emulators.mjs reset",
    "emulators:seed": "node scripts/emulators.mjs seed",
    "test": "vitest run",
    "test:rules": "node scripts/emulators.mjs exec -- vitest run --config vitest.rules.config.ts",
    "test:e2e": "node scripts/emulators.mjs exec -- playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:cleanup:live": "node scripts/cleanup-live-e2e.mjs",
    "seed:platform-settings": "node scripts/seed-platform-settings.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage --project magemai",
    "deploy:functions": "node --experimental-strip-types scripts/deploy-functions.ts",
    "provision:super-admin": "node scripts/provision-super-admin.ts",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project magemai",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
