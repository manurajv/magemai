rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAvatarImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024;
    }

    function memberDoc(businessId) {
      return firestore.get(/databases/(default)/documents/businessMembers/$(businessId + '_' + request.auth.uid));
    }

    function isActiveMember(businessId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/businessMembers/$(businessId + '_' + request.auth.uid))
        && memberDoc(businessId).data.status == 'active';
    }

    function isBrandEditor(businessId) {
      return isActiveMember(businessId)
        && memberDoc(businessId).data.role in ['owner', 'admin', 'manager'];
    }

    function businessIsActive(businessId) {
      return firestore.exists(/databases/(default)/documents/businesses/$(businessId))
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.status == 'active';
    }

    function isBrandImage(maxBytes) {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= maxBytes;
    }

    match /users/{userId}/avatar {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isAvatarImage();
    }

    match /businesses/{businessId}/brand/logo {
      allow read: if isActiveMember(businessId);
      allow write: if isBrandEditor(businessId)
        && businessIsActive(businessId)
        && isBrandImage(2 * 1024 * 1024);
    }

    match /businesses/{businessId}/brand/cover {
      allow read: if isActiveMember(businessId);
      allow write: if isBrandEditor(businessId)
        && businessIsActive(businessId)
        && isBrandImage(5 * 1024 * 1024);
    }

    match /businesses/{businessId}/private/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
